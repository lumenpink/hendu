# Chave de API do Google Gemini (obrigatoria)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo Gemini (padrao oficial: gemini-3.5-flash-lite)
HENDU_GEMINI_MODEL=gemini-3.5-flash-lite

# Caminho do banco de dados SQLite para sessoes do WhatsApp
HENDU_DB_PATH=/data/whatsapp.db

# Modo de operacao em grupos (automatic ou ondemand)
# ondemand: silencio no grupo; processa audio/imagem apenas ao responder com !transcrever ou !descrever
HENDU_GROUP_MODE=ondemand

# Nivel de log (trace, debug, info, warn, error)
RUST_LOG=info

# Funcionalidades de acessibilidade ativas
HENDU_AUDIO_TRANSCRIPTION_ENABLED=true
HENDU_IMAGE_DESCRIPTION_ENABLED=true
HENDU_STICKER_DESCRIPTION_ENABLED=true
